# Copie para .env e preencha (NÃO suba o .env no git).

# Neon → Dashboard do projeto → Connection string (pooled). Ex.:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Segredo para assinar os cookies de sessão (JWT). Gere um aleatório forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Chave da API do Claude (assistente InCiclo). Crie em https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# RD Station MARKETING — funil de LEADS (OAuth2). Crie um App em https://appstore.rdstation.com
# (ou developers.rdstation.com) para obter client_id/client_secret; depois autorize uma vez
# para gerar o refresh_token (não expira; troca-se por access_token a cada consulta).
RD_MKT_CLIENT_ID=
RD_MKT_CLIENT_SECRET=
RD_MKT_REFRESH_TOKEN=
# (Opcional) Nomes EXATOS das segmentações que representam as etapas do funil, na ordem, separados por vírgula.
# Ex.: RD_MKT_STAGES=Leads,Leads Qualificados,Oportunidades,Clientes
# Se vazio, mostramos todas as segmentações da conta.
RD_MKT_STAGES=

# Sankhya ERP — saldo de estoque ao vivo (Gateway de API). Peça à T.I. (Altair):
#   appkey do parceiro, token de integração, e um usuário/senha de serviço com acesso ao saldo.
SANKHYA_BASE_URL=https://api.sankhya.com.br
SANKHYA_APPKEY=
SANKHYA_TOKEN=
SANKHYA_USERNAME=
SANKHYA_PASSWORD=
# (Opcional) SQL de saldo — confirmar filtros de empresa/local com a T.I. Se vazio, usa o padrão.
SANKHYA_STOCK_SQL=
# Mapa produto InCiclo → CODPROD do Sankhya (JSON). Ex.: {"bes":"1001","fg3":"1002","si2":"1003"}
SANKHYA_MAP=
# (Opcional) limite p/ marcar estoque "baixo" (default 2).
SANKHYA_LOW=2

# Segredo que protege os crons diários (funil e estoque). Gere: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
